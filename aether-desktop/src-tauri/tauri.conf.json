{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether Repair Tool",
  "version": "0.1.0",
  "identifier": "dev.aether.repair",
  "build": {
    "beforeDevCommand": "node scripts/prepare.mjs",
    "beforeBuildCommand": "node scripts/prepare.mjs",
    "devUrl": null,
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Aether Repair Tool",
        "label": "main",
        "url": "index.html",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Dark",
        "titleBarStyle": "Visible",
        "shadow": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Aether Repair Tool \u2014 MTK / Qualcomm / iPhone / Samsung repair console.",
    "longDescription": "Unified repair console for licensed technicians. Bundles the Aether web dashboard with the local CLI bridge so the dashboard talks to USB devices directly \u2014 no browser required.",
    "copyright": "\u00a9 2026 Aether Labs",
    "license": "Proprietary",
    "publisher": "Aether Labs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": [
          "en-US"
        ],
        "upgradeCode": "468C488B-6CF2-53FC-9348-8046F90E2C02"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "resources": {
      "runtime/": "runtime/",
      "../../frontend/build/": "dashboard/",
      "../../LICENSE.md": "LICENSE.md",
      "../../aether-cli/NOTICE.md": "NOTICE.md",
      "../../aether-cli/backend/exploits/": "backend/exploits/",
      "../../backend/swclone.py": "backend/swclone.py"
    }
  }
}
